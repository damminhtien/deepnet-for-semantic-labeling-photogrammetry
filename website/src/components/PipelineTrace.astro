---
import trace from '../generated/pipeline-trace.json';
import { route, source } from '../scripts/routes.mjs';

const stages = trace.stages;
const sample = trace.sample;
const window = sample.window;
const assetUrl = (key: string) => route() + 'evidence/pipeline-trace/' + trace.assets[key].file;
const activation = (block: number) => trace.model.activations.find((item) => item.block === block)!;
const confusion = trace.sample_confusion;
const className = (id: number) => sample.class_names[id];
const augmentation = trace.training_lineage.augmentation_policy;
const seedTarget = sample.rare_class_target_name ?? 'coverage draw';
---

<section class="wrap trace-section" aria-labelledby="trace-title" data-pipeline-trace>
  <header class="trace-heading">
    <div>
      <p class="eyebrow">Inspect / one recorded refit training draw</p>
      <h2 id="trace-title">One sample, end to end.</h2>
      <p class="trace-intro">Follow the same Potsdam window through cached RGB, participant labels, the actual training sampler and augmentation code, one final-checkpoint forward pass, and crop-only error counts.</p>
    </div>
    <div class="trace-identity" aria-label="Training sample identity">
      <span>{sample.scene_id}</span>
      <span>row {window.row.toLocaleString('en-US')} · col {window.col.toLocaleString('en-US')}</span>
      <span>512 × 512 · {seedTarget}</span>
    </div>
  </header>

  <p class="trace-scope"><strong>Scope:</strong> this sample was included in final refit training. Its prediction and error counts are an in-sample illustration, not independent benchmark evidence. <a href={trace.dataset_source_url}>Potsdam source ↗</a></p>

  <div class="trace-layout">
    <aside class="trace-viewer" aria-label="Pipeline stage viewer">
      <div class="trace-viewer-head">
        <div>
          <p class="eyebrow" data-active-kicker>Stage 01 / {stages[0].id}</p>
          <h3 data-active-title aria-live="polite">{stages[0].title}</h3>
        </div>
        <span class="trace-counter" data-counter aria-live="polite">01 / 08</span>
      </div>

      {stages.map((stage, index) => <div class="trace-gallery" data-trace-panel={index} data-asset-count={stage.assets.length} hidden={index !== 0} aria-label={`${stage.title} images`}>
        {stage.assets.map((key) => <figure class="trace-figure">
          <img
            src={assetUrl(key)}
            alt={trace.assets[key].alt}
            width={trace.assets[key].width_px}
            height={trace.assets[key].height_px}
            loading={index === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
          <figcaption>{trace.assets[key].visualization}</figcaption>
        </figure>)}
      </div>)}

      <div class="trace-controls">
        <button type="button" data-trace-previous aria-label="Previous pipeline stage" disabled>← Previous</button>
        <button type="button" data-trace-next aria-label="Next pipeline stage">Next →</button>
      </div>
      <nav class="trace-nav" aria-label="Select pipeline stage">
        {stages.map((stage, index) => <button
          type="button"
          data-trace-select={index}
          aria-label={`Show stage ${index + 1}: ${stage.title}`}
          aria-pressed={index === 0 ? 'true' : 'false'}
        >{String(index + 1).padStart(2, '0')}</button>)}
      </nav>
    </aside>

    <div class="trace-story">
      {stages.map((stage, index) => <article
        class="trace-step"
        data-trace-step={index}
        data-title={stage.title}
        id={`trace-step-${stage.id}`}
        aria-current={index === 0 ? 'step' : undefined}
        aria-labelledby={`trace-step-title-${index}`}
        tabindex="-1"
      >
        <p class="eyebrow">{String(index + 1).padStart(2, '0')} / {stage.id}</p>
        <h3 id={`trace-step-title-${index}`}>{stage.title}</h3>
        <p>{stage.summary}</p>
        {stage.id === 'sampling' && <dl class="trace-facts">
          <div><dt>Scene and window</dt><dd>{sample.scene_id} · row {window.row}, col {window.col}</dd></div>
          <div><dt>Sampling target</dt><dd>{seedTarget}{sample.rare_class_target_id !== null ? ` (class ${sample.rare_class_target_id})` : ''}</dd></div>
          <div><dt>Training draw</dt><dd>pass {sample.training_pass_zero_based}, ordinal {sample.training_draw_ordinal_zero_based}</dd></div>
        </dl>}
        {stage.id === 'augmentation' && <>
          <dl class="trace-facts">
            <div><dt>Deterministic draw seed</dt><dd>{sample.draw_seed}</dd></div>
            <div><dt>Affine transform</dt><dd>{(augmentation.affine_probability * 100).toFixed(0)}% chance · ±{augmentation.rotation}° · {augmentation.scale[0]}–{augmentation.scale[1]}× scale</dd></div>
            <div><dt>Translation and halo</dt><dd>±{(augmentation.translation * 100).toFixed(0)}% · {augmentation.halo}px context</dd></div>
            <div><dt>Optical gain</dt><dd>{(augmentation.gain_probability * 100).toFixed(0)}% chance · {augmentation.gain_range[0]}–{augmentation.gain_range[1]}×</dd></div>
          </dl>
          <p class="note">Categorical labels and validity use nearest-neighbor geometry; optical bands use the training implementation's masked interpolation.</p>
        </>}
        {stage.id === 'model-input' && <dl class="trace-facts">
          <div><dt>Cached sample</dt><dd>3 × 512 × 512 · RGB values scaled by 255</dd></div>
          <div><dt>Encoder tensor</dt><dd>1 × 3 × 512 × 512 · normalized after the trained RGB adapter</dd></div>
          <div><dt>Normalization</dt><dd>ImageNet RGB mean and standard deviation</dd></div>
        </dl>}
        {stage.id === 'activations' && <>
          <dl class="trace-facts trace-activation-facts">
            {trace.model.activations.map((item) => <div><dt>Block {item.block}</dt><dd>{item.tensor_shape.join(' × ')} · {item.component_explained_variance_ratio.map((value) => `${(value * 100).toFixed(1)}%`).join(' / ')} variance in displayed components</dd></div>)}
          </dl>
          <p class="note">Each 32 × 32 map is the actual 768-channel feature tensor projected into three principal components. RGB is a display code; component scales are independent, and the maps are not attention.</p>
        </>}
        {stage.id === 'prediction' && <dl class="trace-facts">
          <div><dt>Checkpoint</dt><dd><code>{trace.model.checkpoint_sha256.slice(0, 16)}…</code></dd></div>
          <div><dt>Output</dt><dd>1 × 6 × 512 × 512 logits · argmax class map</dd></div>
          <div><dt>Inference</dt><dd>Identity forward pass · no TTA · no training</dd></div>
        </dl>}
        {stage.id === 'evaluation' && <>
          <dl class="trace-facts">
            <div><dt>Scored pixels</dt><dd>{confusion.scored_pixels.toLocaleString('en-US')}</dd></div>
            <div><dt>Errors in this sample</dt><dd>{confusion.error_pixels.toLocaleString('en-US')}</dd></div>
            <div><dt>Ignored or invalid</dt><dd>{confusion.ignored_or_invalid_pixels_excluded.toLocaleString('en-US')}</dd></div>
          </dl>
          <div class="table-scroll"><table class="trace-errors">
            <caption>Largest reference → prediction counts in this training crop</caption>
            <thead><tr><th scope="col">Reference</th><th scope="col">Prediction</th><th scope="col">Pixels</th></tr></thead>
            <tbody>{confusion.largest_error_pairs.map((pair) => <tr>
              <th scope="row">{className(pair.reference_class_id)}</th>
              <td>{className(pair.predicted_class_id)}</td>
              <td>{pair.pixels.toLocaleString('en-US')}</td>
            </tr>)}</tbody>
          </table></div>
        </>}
        <p class="trace-source"><a href={source(stage.implementation)}>Open {stage.implementation.split('/').at(-1)} ↗</a></p>
      </article>)}
    </div>
  </div>

  <p class="trace-rights">{trace.publication.rights_note} <a href={trace.dataset_source_url}>Dataset provenance ↗</a></p>
</section>

<style>
  .trace-section { padding-block: clamp(2.5rem, 7vw, 6rem); }
  .trace-heading { display: flex; justify-content: space-between; gap: 1.4rem; align-items: end; margin-bottom: 1rem; }
  .trace-heading h2 { font-size: clamp(2rem, 4vw, 3.2rem); margin: .1em 0 .3em; }
  .trace-intro { max-width: 44rem; color: var(--muted); }
  .trace-identity { display: grid; gap: .25rem; flex: 0 0 auto; padding: .75rem .9rem; border-left: 2px solid var(--amber); background: #102e45; color: #f6f5f0; font: 500 .72rem/1.5 var(--mono); }
  .trace-identity span:first-child { color: #f3bf86; font-size: .9rem; }
  .trace-scope, .trace-rights { color: var(--muted); font-size: .8rem; }
  .trace-scope { border-top: 1px solid #37566b; border-bottom: 1px solid #37566b; padding: .65rem 0; }
  .trace-scope strong { color: #8a5426; }
  .trace-scope a, .trace-rights a { color: #245f74; }
  .trace-layout { display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(18rem, .88fr); gap: clamp(1.2rem, 4vw, 3.5rem); align-items: start; margin-top: 1.6rem; }
  .trace-viewer { position: sticky; top: .75rem; min-width: 0; padding: 1rem; background: #0b2239; border: 1px solid #416175; box-shadow: 0 1rem 2.5rem #06152255; }
  .trace-viewer-head { display: flex; justify-content: space-between; gap: 1rem; align-items: start; padding-bottom: .7rem; }
  .trace-viewer-head .eyebrow { margin: 0 0 .2rem; }
  .trace-viewer-head h3 { margin: 0; color: #f6f5f0; font-size: 1.15rem; }
  .trace-counter { color: #f3bf86; font: 500 .72rem var(--mono); white-space: nowrap; }
  .trace-gallery[hidden] { display: none; }
  .trace-gallery { display: grid; height: clamp(18rem, 58vh, 32rem); grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); grid-auto-rows: minmax(0, 1fr); gap: .55rem; align-items: stretch; }
  .trace-gallery[data-asset-count="2"], .trace-gallery[data-asset-count="3"], .trace-gallery[data-asset-count="4"] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .trace-figure { display: grid; grid-template-rows: minmax(0, 1fr) auto; min-width: 0; min-height: 0; height: 100%; margin: 0; overflow: hidden; background: #102e45; }
  .trace-figure img { display: block; width: 100%; height: 100%; min-height: 0; object-fit: contain; background: #102e45; }
  .trace-figure figcaption { max-height: 4.5rem; overflow: auto; padding: .45rem .5rem; color: #c3d1d3; font-size: .65rem; line-height: 1.45; }
  .trace-controls { display: flex; justify-content: space-between; margin-top: .75rem; }
  .trace-controls button, .trace-nav button { border: 1px solid #597386; background: transparent; color: #f6f5f0; padding: .45rem .65rem; cursor: pointer; }
  .trace-controls button:disabled { opacity: .4; cursor: default; }
  .trace-controls button:not(:disabled):hover, .trace-nav button:hover { border-color: var(--amber); color: #f3bf86; }
  .trace-nav { display: flex; gap: .3rem; margin-top: .45rem; }
  .trace-nav button { flex: 1; padding: .32rem .15rem; font: 500 .65rem var(--mono); }
  .trace-nav button[aria-pressed="true"] { background: #f3bf86; border-color: #f3bf86; color: #0b2239; }
  .trace-step { min-height: 72vh; display: flex; flex-direction: column; justify-content: center; padding: 1.4rem 0; border-top: 1px solid #37566b; scroll-margin-block: 15vh; }
  .trace-step:last-child { border-bottom: 1px solid #37566b; }
  .trace-step .eyebrow { color: #245f74; margin: 0 0 .35rem; }
  .trace-step h3 { margin: 0 0 .55rem; font: 500 clamp(1.45rem, 2.4vw, 2rem)/1.15 var(--serif); }
  .trace-step > p:not(.eyebrow):not(.note):not(.trace-source) { max-width: 37rem; color: var(--muted); }
  .trace-facts { display: grid; gap: .4rem; margin: .6rem 0; }
  .trace-facts > div { display: grid; grid-template-columns: minmax(7.5rem, .8fr) minmax(0, 1.2fr); gap: .5rem; border-top: 1px solid #37566b; padding-top: .4rem; }
  .trace-facts dt { color: var(--muted); font: 500 .64rem/1.5 var(--mono); text-transform: uppercase; }
  .trace-facts dd { margin: 0; color: var(--ink); font-size: .78rem; overflow-wrap: anywhere; }
  .trace-step .note { color: var(--muted); font-size: .73rem; }
  .trace-source { margin-top: auto; padding-top: 1rem; font-size: .75rem; }
  .trace-source a { color: #245f74; }
  .trace-errors { width: 100%; border-collapse: collapse; color: var(--ink); font-size: .72rem; }
  .trace-errors caption { padding: .55rem 0; text-align: left; color: #8a5426; }
  .trace-errors th, .trace-errors td { border-bottom: 1px solid #37566b; padding: .38rem .45rem; text-align: left; }
  .trace-errors td:last-child { text-align: right; font-family: var(--mono); }
  .trace-rights { margin-top: 1.25rem; }
  @media (max-width: 820px) {
    .trace-heading { align-items: start; flex-direction: column; }
    .trace-layout { grid-template-columns: minmax(0, 1fr); }
    .trace-viewer { top: 0; z-index: 2; }
    .trace-step { min-height: 60vh; }
  }
  @media (max-width: 520px) {
    .trace-viewer { padding: .65rem; }
    .trace-facts > div { grid-template-columns: 1fr; gap: .05rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .trace-step { scroll-behavior: auto; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-pipeline-trace]')!;
  const steps = Array.from(root.querySelectorAll<HTMLElement>('[data-trace-step]'));
  const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-trace-panel]'));
  const selectors = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-trace-select]'));
  const previous = root.querySelector<HTMLButtonElement>('[data-trace-previous]')!;
  const next = root.querySelector<HTMLButtonElement>('[data-trace-next]')!;
  const heading = root.querySelector<HTMLElement>('[data-active-title]')!;
  const kicker = root.querySelector<HTMLElement>('[data-active-kicker]')!;
  const counter = root.querySelector<HTMLElement>('[data-counter]')!;
  let active = -1;

  function activate(index: number, scroll = false) {
    const nextIndex = Math.max(0, Math.min(steps.length - 1, index));
    if (nextIndex === active) {
      if (scroll) {
        steps[nextIndex].scrollIntoView({
          behavior: matchMedia('(prefers-reduced-motion: reduce)').matches
            ? 'auto'
            : 'smooth',
          block: 'center',
        });
      }
      return;
    }
    active = nextIndex;
    const step = steps[active];
    for (const panel of panels) panel.hidden = Number(panel.dataset.tracePanel) !== active;
    for (const button of selectors) button.setAttribute('aria-pressed', String(Number(button.dataset.traceSelect) === active));
    for (const item of steps) {
      if (Number(item.dataset.traceStep) === active) item.setAttribute('aria-current', 'step');
      else item.removeAttribute('aria-current');
    }
    heading.textContent = step.dataset.title!;
    kicker.textContent = `Stage ${String(active + 1).padStart(2, '0')} / ${step.querySelector('.eyebrow')!.textContent!.split('/').at(-1)!.trim()}`;
    counter.textContent = `${String(active + 1).padStart(2, '0')} / ${String(steps.length).padStart(2, '0')}`;
    previous.disabled = active === 0;
    next.disabled = active === steps.length - 1;
    if (scroll) step.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'center' });
  }

  previous.addEventListener('click', () => activate(active - 1, true));
  next.addEventListener('click', () => activate(active + 1, true));
  selectors.forEach((button) => button.addEventListener('click', () => activate(Number(button.dataset.traceSelect), true)));

  const observer = new IntersectionObserver((entries) => {
    const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
    if (visible) activate(Number((visible.target as HTMLElement).dataset.traceStep));
  }, { threshold: [0.25, 0.5], rootMargin: '-22% 0px -44% 0px' });
  steps.forEach((step) => observer.observe(step));
  activate(0);
</script>
